# PostgreSQL
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_DB=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# pgAdmin (http://localhost:5050).
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=

# Perfil del backend cuando corre dentro de Docker (docker compose --profile backend up).
SPRING_PROFILES_ACTIVE=

# URL del frontend para armar los enlaces de invitación.
FRONTEND_URL=http://localhost:5173

# --- Correo Gmail (opcional) ---------------------------------------------------
# Completa MAIL_USERNAME y MAIL_PASSWORD con una contraseña de aplicación de
# Google (no la contraseña normal). Si quedan vacíos, el enlace de invitación
# se escribe en el log y no se envía correo.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
# false mientras no haya credenciales; true para incluir el correo en /actuator/health.
MAIL_HEALTH_ENABLED=false
# Si se omite, se usa MAIL_USERNAME como remitente.
# MAIL_FROM=

# --- Opcionales en desarrollo (el perfil dev ya trae valores) --------------------
# En staging/producción JWT_SECRET es OBLIGATORIA (mínimo 32 caracteres, aleatoria):
#   openssl rand -base64 48
# JWT_SECRET=
# JWT_EXPIRATION_MINUTES=120
# CORS_ORIGINS=http://localhost:5173

# Sin Docker (PostgreSQL instalado en tu equipo), descomenta:
# spring.docker.compose.enabled=false
