# PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/aprendizaje_usco
SPRING_DATASOURCE_DB=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Configuración local (la misma configuración predeterminada sirve en todos los entornos).
SPRING_FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/dev-data
SPRING_DOCKER_COMPOSE_ENABLED=true
SPRING_JPA_SHOW_SQL=true
SPRING_JPA_FORMAT_SQL=true
# Genera una llave aleatoria de al menos 32 caracteres, también para desarrollo local.
JWT_SECRET=

# Administrador inicial opcional. Configura ambos valores para crearlo si no existe.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAMES=Administrador
BOOTSTRAP_ADMIN_SURNAMES=Sistema

# pgAdmin (http://localhost:5050).
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=

# URL del frontend para armar los enlaces de invitación.
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,https://www.aprendizaje-usco.tech

# --- Correo transaccional mediante Resend API -------------------------------
# Crea una API Key en Resend y guárdala solo en este archivo local o en Render.
RESEND_API_KEY=
MAIL_FROM=Aprendizaje USCO <noreply@aprendizaje-usco.tech>

# --- Configuración para Render + Neon ----------------------------------------
# En Render define estas variables en el panel; no copies valores reales al repo.
# SPRING_DATASOURCE_URL=jdbc:postgresql://<host-neon>:5432/<base>?sslmode=require
# SPRING_DATASOURCE_USERNAME=
# SPRING_DATASOURCE_PASSWORD=
# SPRING_FLYWAY_LOCATIONS=classpath:db/migration
# SPRING_DOCKER_COMPOSE_ENABLED=false
# SPRING_JPA_SHOW_SQL=false
# SPRING_JPA_FORMAT_SQL=false
# JWT_SECRET=<aleatoria, mínimo 32 caracteres; openssl rand -base64 48>
# CORS_ORIGINS=http://localhost:5173,https://www.aprendizaje-usco.tech
# FRONTEND_URL=<origen-del-frontend>
# JWT_EXPIRATION_MINUTES=120
# PORT lo asigna Render automáticamente; no lo definas a mano.
